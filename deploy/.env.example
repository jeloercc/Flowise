# Zero-Context Guard — example environment file
# Copy this to .env and replace every CHANGE_ME_* / PLACEHOLDER_* value.
# NEVER commit a .env file with real secrets.
# Generate random secrets with: openssl rand -hex 32

# --- Server ---
PORT=3000

# --- Auth (UI login) ---
FLOWISE_USERNAME=demo
FLOWISE_PASSWORD=CHANGE_ME_demo_password

# --- Storage (must point to a persistent volume mount) ---
DATABASE_PATH=/data/.flowise
SECRETKEY_PATH=/data/.flowise

# --- JWT & session secrets (generate random values) ---
JWT_AUTH_TOKEN_SECRET=CHANGE_ME_jwt_auth_secret_32chars_hex
JWT_REFRESH_TOKEN_SECRET=CHANGE_ME_jwt_refresh_secret_32chars_hex
EXPRESS_SESSION_SECRET=CHANGE_ME_express_session_secret_32chars

# --- Security (MUST stay true in production / demo) ---
HTTP_SECURITY_CHECK=true

# --- Telemetry ---
DISABLE_FLOWISE_TELEMETRY=true

# --- Optional: LLM keys (use fake keys for demo; real keys only with billing limits) ---
# OPENAI_API_KEY=sk-FAKE-DEMO-0000000000
